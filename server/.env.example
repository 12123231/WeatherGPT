# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Optional: Weather Provider Configuration (e.g. OpenWeatherMap)
# If left blank, server gracefully operates in high-fidelity mock/fallback mode
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Optional: AI Provider Configuration (e.g. Gemini or OpenAI)
# If left blank, server uses built-in meteorological reasoning engine
AI_API_KEY=
AI_PROVIDER=none
